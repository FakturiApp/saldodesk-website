---
import Logo from './Logo.astro'
import Todo from './Todo.astro'
import { type Lang, NAV, useT, pageHref } from '../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useT(lang)
const LINKS = [...NAV, 'uslovi', 'privatnost'].map((p) => ({ href: pageHref(lang, p as any), label: t(`page.${p}` as any) }))
const year = new Date().getFullYear()
---
<footer class="mt-auto border-t border-line bg-surface">
  <div class="wrap grid gap-8 py-12 md:grid-cols-[1fr_2fr]">
    <div>
      <Logo />
      <p class="mt-4 max-w-xs text-[0.9375rem] text-mut">{t('site.description')}</p>
    </div>
    <nav aria-label="SaldoDesk">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2.5 text-[0.9375rem] sm:grid-cols-3">
        {LINKS.map((l) => <li><a href={l.href} class="text-mut hover:text-accent-tx">{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <div class="wrap flex flex-wrap items-center justify-between gap-3 py-6 text-xs text-mut">
      <p>© {year} SaldoDesk. {t('footer.rights')}</p>
      <Todo lang={lang}>{t('footer.company')}</Todo>
    </div>
  </div>
</footer>
