---
// One quiet round button, upper left, that appears once the visitor has scrolled down a long
// page and takes them back to the top (owner 2026-11-26).
import { type Lang, useT } from '../i18n/ui'
interface Props { lang: Lang }
const t = useT(Astro.props.lang)
---
<button type="button" data-to-top aria-label={t('top')} title={t('top')}
        class="to-top fixed left-3 top-[5.75rem] z-20 grid h-11 w-11 place-items-center rounded-full border border-line bg-surface/90 text-mut shadow-[var(--shadow)] backdrop-blur transition hover:border-accent hover:text-accent-tx md:left-5">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
</button>

<style>
  .to-top { opacity: 0; transform: translateY(-0.5rem); pointer-events: none; transition: opacity 0.25s, transform 0.25s, border-color 0.15s, color 0.15s; }
  .to-top.is-shown { opacity: 1; transform: none; pointer-events: auto; }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-to-top]')
  if (btn) {
    const sync = () => btn.classList.toggle('is-shown', window.scrollY > 600)
    window.addEventListener('scroll', sync, { passive: true })
    sync()
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
      if (location.hash) history.replaceState(null, '', location.pathname)
    })
  }
</script>
