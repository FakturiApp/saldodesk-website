---
// One task of „Како работи" with its STEP PLAYER (owner 2026-11-26): every step has its own
// short video (scripts/record-app.mjs → public/rec/<lang>/<task>/<n>.webm). Click a step, its
// video plays; when it ends the next step follows, like a short story. A step bar under the
// video shows where you are; the step's words are repeated under it.
// Without recordings the card shows the steps alone. Without JavaScript: the first step's still.
import Icon from './Icon.astro'
import Arrow from './Arrow.astro'
import REC from '../data/rec.json'
import type { Task, T } from '../content/tasks/types'
import { type Lang, pageHref } from '../i18n/ui'

interface Props { task: Task; lang: Lang; help: Map<string, string>; areaPlan?: T; labels: { steps: string; more: string; next: string; replay: string } }
const { task: f, lang, help, areaPlan, labels } = Astro.props
const rec = (REC as Record<string, Partial<Record<Lang, { steps: number[] }>>>)[f.id]
const recLang = rec?.[lang] ? lang : rec?.mk ? 'mk' : null
const clips = recLang && rec![recLang]!.steps.length === f.steps.length
  ? f.steps.map((_, i) => ({ src: `/rec/${recLang}/${f.id}/${i + 1}.webm`, poster: `/rec/${recLang}/${f.id}/${i + 1}.webp` }))
  : null
const stepText = f.steps.map((s) => s[lang])
---
<article id={f.id} data-flash data-task={clips ? JSON.stringify({ clips, text: stepText }) : undefined}
         class="flash card relative scroll-mt-28 p-5 md:p-8">
  <div class:list={['grid gap-8', clips && 'lg:grid-cols-[19rem_1fr] lg:gap-10']}>
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <span class="grid h-10 w-10 place-items-center rounded-xl bg-surface-2 text-accent-tx"><Icon name={f.icon} class="h-5 w-5" /></span>
        <h4 class="text-xl font-extrabold md:text-2xl">{f.title[lang]}</h4>
      </div>
      {f.plan && !areaPlan && <p class="mt-3"><a href={pageHref(lang, 'ceni')} class="inline-flex rounded-full bg-hi px-3 py-1 text-sm font-bold text-hi-ink">{f.plan[lang]}</a></p>}
      <p class="mt-3 text-mut">{f.intro[lang]}</p>

      <p class="mt-5 text-xs font-bold uppercase tracking-wide text-mut">{labels.steps}</p>
      <ol class="mt-2 space-y-1.5">
        {stepText.map((s, j) => (
          <li>
            <button type="button" data-step={j} disabled={!clips}
                    class="step flex w-full gap-3 rounded-2xl border border-transparent p-2.5 text-left text-[0.9375rem] transition enabled:hover:border-line enabled:hover:bg-surface-2">
              <span class="step-n mt-px grid h-6 w-6 shrink-0 place-items-center rounded-full bg-tx text-xs font-bold text-bg transition">{j + 1}</span>
              <span>{s}</span>
            </button>
          </li>
        ))}
      </ol>

      {f.help.some((s) => help.has(s)) && (
        <div class="mt-6">
          <p class="text-xs font-bold uppercase tracking-wide text-mut">{labels.more}</p>
          <ul class="mt-2 space-y-1">
            {f.help.filter((s) => help.has(s)).map((s) => (
              <li><a href={`${pageHref(lang, 'pomosh')}${s}/`} class="inline-flex items-start gap-2 text-[0.9375rem] font-semibold text-accent-tx hover:underline"><span class="mt-1 shrink-0"><Arrow /></span>{help.get(s)}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>

    {clips && (
      <div class="min-w-0">
        <div class="relative overflow-hidden rounded-2xl border border-line bg-surface-2 shadow-[var(--shadow)]">
          <video data-video muted playsinline preload="none" width="1280" height="800" poster={clips[0].poster}
                 class="block aspect-[16/10] h-auto w-full bg-surface-2" aria-label={f.title[lang]}></video>
          <button type="button" data-replay hidden
                  class="absolute inset-0 grid place-items-center bg-[#0d1220]/45 text-white backdrop-blur-[1px]">
            <span class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 font-bold text-accent-ink">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.7M4 4v4h4" /></svg>
              {labels.replay}
            </span>
          </button>
          <span data-next hidden class="absolute bottom-3 right-3 rounded-full bg-accent px-3.5 py-1.5 text-sm font-bold text-accent-ink shadow-lg">{labels.next} →</span>
        </div>
        <div class="mt-3 flex gap-1.5" aria-hidden="true">
          {stepText.map((_, j) => (
            <button type="button" tabindex="-1" data-seg={j} class="seg h-1.5 flex-1 overflow-hidden rounded-full bg-line">
              <span class="block h-full w-0 bg-accent"></span>
            </button>
          ))}
        </div>
        <p data-caption class="mt-3 flex gap-2.5 text-lg font-semibold leading-snug" aria-live="polite">
          <span class="num text-accent-tx">1</span><span>{stepText[0]}</span>
        </p>
      </div>
    )}
  </div>
</article>

<style>
  .step.is-now { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); font-weight: 600; }
  .step.is-now .step-n, .step:enabled:hover .step-n { background: var(--accent); color: var(--accent-ink); }
  .step.is-done .step-n { background: color-mix(in srgb, var(--accent) 45%, var(--tx)); }
  .seg.is-done span { width: 100%; }
</style>

<script>
  // The step player. One video element per task; the source changes with the step.
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches
  document.querySelectorAll<HTMLElement>('[data-task]').forEach((card) => {
    const { clips, text } = JSON.parse(card.dataset.task ?? '{}') as { clips: { src: string; poster: string }[]; text: string[] }
    const video = card.querySelector<HTMLVideoElement>('[data-video]')!
    const steps = Array.from(card.querySelectorAll<HTMLButtonElement>('[data-step]'))
    const segs = Array.from(card.querySelectorAll<HTMLElement>('[data-seg]'))
    const caption = card.querySelector<HTMLElement>('[data-caption]')!
    const replay = card.querySelector<HTMLElement>('[data-replay]')!
    const next = card.querySelector<HTMLElement>('[data-next]')!
    let now = 0
    let story = !still // play on through the steps
    let started = false
    let timer = 0
    const preload = (i: number) => { if (clips[i]) { const v = document.createElement('video'); v.preload = 'auto'; v.muted = true; v.src = clips[i].src } }

    const show = (i: number, play: boolean) => {
      clearTimeout(timer)
      now = i
      next.hidden = true
      replay.hidden = true
      steps.forEach((s, j) => { s.classList.toggle('is-now', j === i); s.classList.toggle('is-done', j < i) })
      segs.forEach((s, j) => { s.classList.toggle('is-done', j < i); (s.firstElementChild as HTMLElement).style.width = j < i ? '100%' : '0' })
      caption.innerHTML = ''
      const n = document.createElement('span'); n.className = 'num text-accent-tx'; n.textContent = String(i + 1)
      const t = document.createElement('span'); t.textContent = text[i]
      caption.append(n, t)
      video.poster = clips[i].poster
      video.src = clips[i].src
      if (play) video.play().catch(() => {})
      preload(i + 1)
    }

    video.addEventListener('timeupdate', () => {
      const fill = segs[now]?.firstElementChild as HTMLElement | undefined
      if (fill && video.duration) fill.style.width = `${Math.min(100, (video.currentTime / video.duration) * 100)}%`
    })
    video.addEventListener('ended', () => {
      steps[now].classList.add('is-done')
      if (now + 1 < clips.length && story) {
        next.hidden = false
        timer = window.setTimeout(() => show(now + 1, true), 1100)
      } else if (now + 1 >= clips.length) {
        replay.hidden = false
      }
    })
    video.addEventListener('click', () => { if (video.paused) video.play().catch(() => {}); else video.pause() })
    replay.addEventListener('click', () => { story = !still; show(0, true) })
    const pick = (i: number) => { started = true; story = !still; show(i, true) }
    steps.forEach((s, i) => s.addEventListener('click', () => pick(i)))
    segs.forEach((s, i) => s.addEventListener('click', () => pick(i)))

    // On screen: start the story once; off screen: pause; back: carry on.
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) {
        if (!started && !still) { started = true; show(0, true) }
        else if (started && video.paused && !video.ended && replay.hidden) video.play().catch(() => {})
      } else {
        video.pause()
        clearTimeout(timer)
      }
    }, { threshold: 0.55 }).observe(video)
  })
</script>
