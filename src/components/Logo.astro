---
// The SaldoDesk mark (isometric ledger slabs + rising bars + arrow), the same paths as the
// app's ui/BrandLogo.tsx and favicon.svg — fixed brand colours, never themed.
interface Props { class?: string; wordmark?: boolean }
const { class: cls = '', wordmark = true } = Astro.props
---
<span class:list={['inline-flex items-center gap-2', cls]}>
  <svg viewBox="0 0 48 48" width="32" height="32" aria-hidden="true" focusable="false">
  <g transform="translate(0.5 3.2)">
    <g><path d="M5 14 L11 10.5 L22 17 L16 20.5 Z" fill="#4d87cd"/><path d="M5 14 L16 20.5 L16 24 L5 17.5 Z" fill="#2a63a3"/><path d="M16 20.5 L22 17 L22 20.5 L16 24 Z" fill="#1d4e86"/></g>
    <g><path d="M5 21 L11 17.5 L22 24 L16 27.5 Z" fill="#4d87cd"/><path d="M5 21 L16 27.5 L16 31 L5 24.5 Z" fill="#2a63a3"/><path d="M16 27.5 L22 24 L22 27.5 L16 31 Z" fill="#1d4e86"/></g>
    <g><path d="M5 28 L11 24.5 L22 31 L16 34.5 Z" fill="#4d87cd"/><path d="M5 28 L16 34.5 L16 38 L5 31.5 Z" fill="#2a63a3"/><path d="M16 34.5 L22 31 L22 34.5 L16 38 Z" fill="#1d4e86"/></g>
    <g><path d="M19 26 L24 28.9 L24 36.9 L19 34 Z" fill="#159d73"/><path d="M19 26 L21.4 24.6 L26.4 27.5 L24 28.9 Z" fill="#3fe0ad"/><path d="M24 28.9 L26.4 27.5 L26.4 35.5 L24 36.9 Z" fill="#12805d"/></g>
    <g><path d="M25 21 L30 23.9 L30 36.9 L25 34 Z" fill="#159d73"/><path d="M25 21 L27.4 19.6 L32.4 22.5 L30 23.9 Z" fill="#3fe0ad"/><path d="M30 23.9 L32.4 22.5 L32.4 35.5 L30 36.9 Z" fill="#12805d"/></g>
    <g><path d="M31 16 L36 18.9 L36 36.9 L31 34 Z" fill="#159d73"/><path d="M31 16 L33.4 14.6 L38.4 17.5 L36 18.9 Z" fill="#3fe0ad"/><path d="M36 18.9 L38.4 17.5 L38.4 35.5 L36 36.9 Z" fill="#12805d"/></g>
    <path d="M18 24.5 L27 19.5 L32 22 L41 13.5" stroke="#3fe0ad" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M35.5 12.5 L42 12.5 L42 19" stroke="#3fe0ad" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
  </svg>
  {wordmark && (
    <span class="text-[1.3rem] leading-none tracking-tight text-tx">
      <b class="font-extrabold">Saldo</b><span class="font-medium">Desk</span>
    </span>
  )}
</span>
