---
// The symbols of the app's own parts (owner 2026-11-26: „the same symbols as in the app").
// partner, product, invoice, trend and gear are the app's drawings (frontend/src/ui/icons.tsx:
// SymPartner, SymProduct, SymInvoice, TrendLine, Gear), redrawn here on the same 24 grid; the
// rest are drawn in the same hand: stroke 1.7, round caps and joins.
export const APP_ICONS = ['home', 'partner', 'product', 'invoice', 'money', 'trend', 'wrench', 'printer', 'leaf', 'globe', 'store', 'gear'] as const
export type AppIconName = (typeof APP_ICONS)[number]
interface Props { name: AppIconName; class?: string }
const { name, class: cls = 'h-6 w-6' } = Astro.props
const D: Record<AppIconName, string> = {
