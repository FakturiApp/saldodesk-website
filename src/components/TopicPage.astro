---
// One topic, one page (owner 2026-11-16): hook → plain explanation → a drawn screen with
// numbered pins → what else it does → the other questions → the closing call.
import Base from '../layouts/Base.astro'
import Rich from './Rich.astro'
import CtaBand from './CtaBand.astro'
import TopicCards from './TopicCards.astro'
import PartnerChip from './mock/PartnerChip.astro'
import InvoiceLine from './mock/InvoiceLine.astro'
import Ledger from './mock/Ledger.astro'
import Families from './mock/Families.astro'
import Import from './mock/Import.astro'
import StockShort from './mock/StockShort.astro'
import PinLegend from './mock/PinLegend.astro'
import { topicFor } from '../content/topics'
import { type Lang, type Page, useT } from '../i18n/ui'

interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props
const t = useT(lang)
const T = topicFor(page)!
---
<Base lang={lang} page={page} title={t(`page.${page}`)}>
  <section class="relative overflow-hidden">
    <div class="glow -right-32 -top-24 h-[28rem] w-[28rem]" style="background:var(--glow-a)" aria-hidden="true"></div>
    <div class="wrap relative pt-14 pb-10 md:pt-20">
      <p class="kicker">{T.tag}</p>
      <h1 class="mt-4 max-w-4xl text-[2.4rem] md:text-[3.5rem]"><Rich text={T.title} /></h1>
      <p class="mt-6 max-w-3xl text-lg text-mut md:text-xl">{T.explain}</p>
    </div>
  </section>

  <section class="wrap pb-6">
    {T.mock === 'partner' && <div class="max-w-2xl"><PartnerChip pins /></div>}
    {T.mock === 'invoice' && <InvoiceLine />}
    {T.mock === 'ledger' && <Ledger />}
    {T.mock === 'families' && <Families />}
    {T.mock === 'import' && <div class="max-w-3xl"><Import /></div>}
    {T.legend && <PinLegend items={T.legend} />}
  </section>

  {T.more && (
    <section class="wrap py-12">
      <ul class="grid gap-4 md:grid-cols-3">
        {T.more.map((m) => (
          <li class="card p-6">
            <p class="text-lg font-bold">{m.t}</p>
            <p class="mt-1 text-mut">{m.d}</p>
          </li>
        ))}
      </ul>
      {T.note && <p class="mt-6 text-mut">{T.note}</p>}
    </section>
  )}

  {page === 'dobivka' && (
    <section class="wrap grid items-center gap-10 py-8 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <h2 class="text-2xl md:text-3xl">Нема доволно на залиха?</h2>
        <p class="mt-4 text-lg text-mut">Пред да издадете, програмата кажува колку фали, кој магацин ја има и кој производ може да оди наместо него.</p>
      </div>
      <StockShort />
    </section>
  )}

  <section class="wrap py-12">
    <h2 class="text-2xl md:text-3xl">Што уште сакате да дознаете?</h2>
    <div class="mt-8"><TopicCards lang={lang} except={page} /></div>
  </section>

  <CtaBand lang={lang} section={`topic-${page}`} />
</Base>
