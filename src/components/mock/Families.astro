---
// The document families, as the app colours them (one stripe per family).
const FAMILIES = [
  { c: 'border-fam-sell text-fam-sell', name: 'Продажба', docs: ['Понуда', 'Профактура', 'Испратница', 'Фактура', 'Авансна фактура'] },
  { c: 'border-fam-buy text-fam-buy', name: 'Набавка', docs: ['Приемница', 'Фактура — Приемница', 'Влезна фактура — трошок'] },
  { c: 'border-fam-credit text-fam-credit', name: 'Книжни', docs: ['Сторно', 'КО / КЗ', 'Повратница', 'Компензација'] },
  { c: 'border-fam-internal text-fam-internal', name: 'Внатрешни', docs: ['Пренос', 'Попис', 'Нивелација', 'Требовање', 'Отпис'] },
]
---
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {FAMILIES.map((f) => (
    <div class:list={['card border-t-[6px] p-6', f.c.split(' ')[0]]}>
      <p class:list={['text-lg font-extrabold', f.c.split(' ')[1]]}>{f.name}</p>
      <ul class="mt-3 space-y-1.5 text-[0.9375rem] text-tx">{f.docs.map((d) => <li>{d}</li>)}</ul>
    </div>
  ))}
</div>
