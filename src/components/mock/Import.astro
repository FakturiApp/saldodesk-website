---
// Вчитај податоци, drawn with an invented file and invented counts.
import Window from './Window.astro'
import Pin from './Pin.astro'
const map = [['Назив', 'Име'], ['ЕДБ', 'Даночен број'], ['Место', 'Град'], ['Валута дена', 'Рок на плаќање']]
---
<Window title="Вчитај податоци — Партнери">
  <div class="flex flex-wrap items-center gap-3 rounded-xl bg-surface-2 px-3 py-2.5">
    <Pin n={1} /><span class="font-semibold">partneri_stara_programa.xlsx</span><span class="text-mut">· 2.180 редови</span>
  </div>
  <div class="mt-3 rounded-xl border border-line p-3">
    <p class="mb-2 flex items-center gap-2 font-bold"><Pin n={2} /> Колони</p>
    <ul class="grid gap-1.5 sm:grid-cols-2">
      {map.map(([a, b]) => (
        <li class="flex items-center gap-2"><span class="rounded-md bg-surface-2 px-2 py-1">{a}</span><span class="text-mut">→</span><span class="rounded-md bg-accent/25 px-2 py-1 font-semibold">{b}</span></li>
      ))}
    </ul>
  </div>
  <div class="mt-3 flex flex-wrap items-center gap-2 rounded-xl border border-line p-3">
    <Pin n={3} /><span class="font-bold">Преглед:</span>
    <span class="rounded-full bg-accent px-2.5 py-0.5 text-xs font-bold text-accent-ink">2.140 нови</span>
    <span class="rounded-full bg-info-bg px-2.5 py-0.5 text-xs font-bold text-info-tx">36 се менуваат</span>
    <span class="rounded-full bg-surface-2 px-2.5 py-0.5 text-xs font-bold text-warn-tx">4 не се читаат</span>
  </div>
</Window>
