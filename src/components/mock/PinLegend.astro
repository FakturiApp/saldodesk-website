---
interface Props { items: string[] }
const { items } = Astro.props
---
<ol class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2">
  {items.map((t, i) => (
    <li class="flex gap-3 text-[0.9375rem] leading-snug text-mut">
      <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-tx text-xs font-bold text-bg">{i + 1}</span>
      <span>{t}</span>
    </li>
  ))}
</ol>
