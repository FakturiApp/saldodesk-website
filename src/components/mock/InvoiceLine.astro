---
// One line of an invoice with its info strip — invented product and figures.
// 4 × 2.150,00 less 5 % = 8.170,00 без ДДВ; + 18 % = 9.640,60. Цена со ДДВ 2.537,00 → по попуст 2.410,15.
import Window from './Window.astro'
import Pin from './Pin.astro'
const box = 'rounded-lg border border-line bg-surface-2 px-2.5 py-2 num'
---
<Window title="Нова фактура">
  <div class="grid grid-cols-2 gap-2 sm:grid-cols-[2.2fr_0.6fr_1fr_0.7fr_0.6fr_1.2fr_1.1fr]">
    <div class="col-span-2 sm:col-span-1"><p class="mb-1 text-[0.6875rem] font-bold uppercase text-mut">Производ</p><div class={box}><span class="text-mut">КК-ТН-01</span> · Тонер црн 3.000 стр.</div></div>
    <div><p class="mb-1 text-[0.6875rem] font-bold uppercase text-mut">Кол.</p><div class={box}>4</div></div>
    <div><p class="mb-1 text-[0.6875rem] font-bold uppercase text-mut">Цена</p><div class={box}>2.150,00</div></div>
    <div><p class="mb-1 text-[0.6875rem] font-bold uppercase text-mut">Попуст %</p><div class={box}>5</div></div>
    <div><p class="mb-1 text-[0.6875rem] font-bold uppercase text-mut">ДДВ</p><div class={box}>18 %</div></div>
    <div><p class="mb-1 flex items-center gap-1.5 text-[0.6875rem] font-bold uppercase text-mut">Цена со ДДВ <Pin n={4} class="h-5 w-5 text-[0.6875rem] ring-2" /></p><div class={box}>2.537,00</div><p class="mt-0.5 text-right text-[0.6875rem] font-semibold text-accent-tx">по попуст 2.410,15</p></div>
    <div><p class="mb-1 text-[0.6875rem] font-bold uppercase text-mut">Вкупно со ДДВ</p><div class={box}>9.640,60</div></div>
  </div>
  <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 rounded-xl bg-surface-2 px-3 py-2.5 text-[0.8125rem]">
    <span class="flex items-center gap-2"><Pin n={1} /> Залиха: тука <b>26</b> · вкупно <b>41</b></span>
    <span class="flex items-center gap-2"><Pin n={2} /> Набавна цена: <b class="num">1.380,00</b> <span class="text-mut">без ДДВ</span></span>
    <span class="flex items-center gap-2"><Pin n={3} /> Продажна цена: <b class="num">2.150,00</b></span>
    <span class="ml-auto flex items-center gap-2"><Pin n={5} /><span class="rounded-full border border-line bg-surface px-3 py-1 font-semibold">Додај во нарачка</span></span>
  </div>
</Window>
