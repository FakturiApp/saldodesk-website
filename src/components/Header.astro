---
import Logo from './Logo.astro'
import LangSwitch from './LangSwitch.astro'
import Arrow from './Arrow.astro'
import { type Lang, type Page, NAV as TABS, useT, pageHref, signupUrl, loginUrl } from '../i18n/ui'

interface Props { lang: Lang; page?: Page; subpath?: string }
const { lang, page, subpath } = Astro.props
const t = useT(lang)

// The tabs (owner 2026-11-26): Функции, Преглед, Цени, Помош, Контакт.
const NAV = TABS.map((p) => ({ href: pageHref(lang, p), label: t(`page.${p}`), current: p === page }))
---
<header class="sticky top-0 z-30 px-3 pt-3 md:px-5">
  <div class="mx-auto flex h-16 max-w-[76rem] items-center gap-2 rounded-full border border-line bg-surface/90 pl-4 pr-2 shadow-[var(--shadow)] backdrop-blur sm:gap-3 sm:pl-5">
    <a href={pageHref(lang)} class="shrink-0" aria-label="SaldoDesk"><Logo /></a>

    <nav aria-label={t('nav.main')} class="ml-4 hidden lg:block">
      <ul class="flex items-center gap-1">
        {NAV.map((n) => (
          <li>
            <a href={n.href} aria-current={n.current ? 'page' : undefined}
               class="whitespace-nowrap rounded-full px-3.5 py-2 text-[0.9375rem] font-medium text-mut transition-colors hover:text-tx aria-[current=page]:font-bold aria-[current=page]:text-tx aria-[current=page]:[box-shadow:inset_0_-0.4em_0_var(--hi)]"
            >{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <div class="hidden sm:block"><LangSwitch lang={lang} page={page} subpath={subpath} /></div>
      <button type="button" data-theme-toggle class="hidden h-10 w-10 shrink-0 place-items-center rounded-full text-mut hover:bg-surface-2 hover:text-tx sm:grid"
              data-label-light={t('theme.toLight')} data-label-dark={t('theme.toDark')} aria-label={t('theme.toLight')} title={t('theme.toLight')}>
        <svg class="theme-sun h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-moon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/></svg>
      </button>
      <a href={loginUrl(lang)} class="hidden whitespace-nowrap rounded-full px-3.5 py-2 text-[0.9375rem] font-semibold text-tx hover:bg-surface-2 lg:inline-block">{t('cta.login')}</a>
      <a href={signupUrl(lang)} class="pill pill-accent pill-sm" data-event="cta_trial_click" data-section="header">
        <span class="hidden sm:inline">{t('cta.trial')}</span><span class="sm:hidden">{t('cta.trialShort')}</span><span class="pill-arrow"><Arrow /></span>
      </a>

      <!-- Phone and tablet menu: a native disclosure, so it needs no JavaScript. -->
      <details class="group relative lg:hidden">
        <summary class="grid h-11 w-11 cursor-pointer list-none place-items-center rounded-full bg-tx text-bg [&::-webkit-details-marker]:hidden" aria-label={t('menu')}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path class="group-open:hidden" d="M4 8h16M4 16h16" />
            <path class="hidden group-open:block" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </summary>
        <div class="card absolute right-0 top-[calc(100%+0.75rem)] w-[min(19rem,calc(100vw-1.5rem))] p-3 shadow-[var(--shadow)]">
          <ul>
            {NAV.map((n) => (
              <li><a href={n.href} aria-current={n.current ? 'page' : undefined} class="block rounded-2xl px-4 py-3 text-lg font-semibold hover:bg-surface-2 aria-[current=page]:text-accent-tx">{n.label}</a></li>
            ))}
            <li class="mt-2 border-t border-line pt-2">
              <a href={loginUrl(lang)} class="block rounded-2xl px-4 py-3 text-mut hover:bg-surface-2 hover:text-tx">{t('cta.login')}</a>
            </li>
          </ul>
          <div class="mt-2 flex items-center justify-between border-t border-line px-4 pt-3 pb-1 sm:hidden">
            <LangSwitch lang={lang} page={page} subpath={subpath} />
            <button type="button" data-theme-toggle class="grid h-10 w-10 place-items-center rounded-full text-mut hover:bg-surface-2 hover:text-tx"
                    data-label-light={t('theme.toLight')} data-label-dark={t('theme.toDark')} aria-label={t('theme.toLight')} title={t('theme.toLight')}>
              <svg class="theme-sun h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
              <svg class="theme-moon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/></svg>
            </button>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  :global(:root[data-theme='light']) .theme-sun,
  :global(:root[data-theme='dark']) .theme-moon { display: none; }
</style>
