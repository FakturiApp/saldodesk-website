---
import Logo from './Logo.astro'
import LangSwitch from './LangSwitch.astro'
import Arrow from './Arrow.astro'
import { type Lang, type Page, NAV as TABS, LANGS, LANG_LABEL, LANG_NAME, useT, pageHref, signupUrl, loginUrl } from '../i18n/ui'

interface Props { lang: Lang; page?: Page; subpath?: string }
const { lang, page, subpath } = Astro.props
const t = useT(lang)

// The tabs (owner 2026-11-26): Функции, Преглед, Цени, Помош, Контакт.
const NAV = TABS.map((p) => ({ href: pageHref(lang, p), label: t(`page.${p}`), current: p === page }))
const langHref = (l: Lang) => (subpath ? `/${l}/${subpath}` : pageHref(l, page))
const sun = '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>'
const moon = '<path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/>'
---
<header class="sticky top-0 z-30 px-2 pt-2 md:px-5 md:pt-3">
  <div class="mx-auto flex h-14 max-w-[76rem] items-center gap-2 rounded-full border border-line bg-surface/90 pl-4 pr-1.5 shadow-[var(--shadow)] backdrop-blur md:h-16 sm:gap-3 sm:pl-5 sm:pr-2">
    <a href={pageHref(lang)} class="shrink-0" aria-label="SaldoDesk"><Logo /></a>

    <nav aria-label={t('nav.main')} class="ml-4 hidden lg:block">
      <ul class="flex items-center gap-1">
        {NAV.map((n) => (
          <li>
            <a href={n.href} aria-current={n.current ? 'page' : undefined}
               class="whitespace-nowrap rounded-full px-3.5 py-2 text-[0.9375rem] font-medium text-mut transition-colors hover:text-tx aria-[current=page]:font-bold aria-[current=page]:text-tx aria-[current=page]:[box-shadow:inset_0_-0.4em_0_var(--hi)]"
            >{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <div class="hidden lg:block"><LangSwitch lang={lang} page={page} subpath={subpath} /></div>
      <button type="button" data-theme-toggle class="hidden h-10 w-10 shrink-0 place-items-center rounded-full text-mut hover:bg-surface-2 hover:text-tx lg:grid"
              data-label-light={t('theme.toLight')} data-label-dark={t('theme.toDark')} aria-label={t('theme.toLight')} title={t('theme.toLight')}>
        <svg class="theme-sun h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={sun} />
        <svg class="theme-moon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={moon} />
      </button>
      <a href={loginUrl(lang)} class="hidden whitespace-nowrap rounded-full px-3.5 py-2 text-[0.9375rem] font-semibold text-tx hover:bg-surface-2 lg:inline-block">{t('cta.login')}</a>
      <!-- On a phone the call to try it lives in the bar at the bottom (MobileCta). -->
      <a href={signupUrl(lang)} class="pill pill-accent pill-sm hidden sm:inline-flex" data-event="cta_trial_click" data-section="header">
        <span>{t('cta.trial')}</span><span class="pill-arrow"><Arrow /></span>
      </a>
      <button type="button" data-menu-open aria-controls="site-menu" aria-expanded="false" aria-label={t('menu')}
              class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-tx text-bg lg:hidden">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h11" /></svg>
      </button>
    </div>
  </div>
</header>

<!-- Phone and tablet menu: the whole screen, big targets, everything one thumb away. -->
<div id="site-menu" data-menu hidden role="dialog" aria-modal="true" aria-label={t('menu')} class="site-menu fixed inset-0 z-50 flex flex-col bg-bg lg:hidden">
  <div class="flex h-16 shrink-0 items-center justify-between px-4 pt-2">
    <a href={pageHref(lang)} aria-label="SaldoDesk"><Logo /></a>
    <button type="button" data-menu-close aria-label={t('menu.close')} class="grid h-11 w-11 place-items-center rounded-full bg-surface-2 text-tx">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
  <nav aria-label={t('nav.main')} class="flex-1 overflow-y-auto px-4 pb-4">
    <ul class="divide-y divide-line border-b border-line">
      <li>
        <a href={pageHref(lang)} aria-current={!page ? 'page' : undefined} class="menu-link">{lang === 'mk' ? 'Почетна' : 'Home'}<Arrow /></a>
      </li>
      {NAV.map((n) => (
        <li><a href={n.href} aria-current={n.current ? 'page' : undefined} class="menu-link">{n.label}<Arrow /></a></li>
      ))}
    </ul>
    <div class="mt-6 grid grid-cols-2 gap-2.5">
      <div class="seg" role="group" aria-label={t('lang.label')}>
        {LANGS.map((l) => (
          <a href={langHref(l)} hreflang={l} lang={l} title={LANG_NAME[l]} data-lang-choice={l} aria-current={l === lang ? 'true' : undefined} class="seg-item">{LANG_LABEL[l]}</a>
        ))}
      </div>
      <button type="button" data-theme-toggle class="seg seg-theme"
              data-label-light={t('theme.toLight')} data-label-dark={t('theme.toDark')} aria-label={t('theme.toLight')}>
        <span class="seg-item seg-dark"><svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={moon} /></span>
        <span class="seg-item seg-light"><svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={sun} /></span>
      </button>
    </div>
  </nav>
  <div class="shrink-0 space-y-2.5 border-t border-line px-4 pt-4 pb-[max(1.25rem,env(safe-area-inset-bottom))]">
    <a href={signupUrl(lang)} class="pill pill-accent w-full justify-between" data-event="cta_trial_click" data-section="menu">
      <span>{t('cta.trial')}</span><span class="pill-arrow"><Arrow /></span>
    </a>
    <a href={loginUrl(lang)} class="pill pill-ghost w-full justify-center">{t('cta.login')}</a>
    <p class="pt-1 text-center text-sm text-mut">{t('cta.free')} · {t('cta.noCard')}</p>
  </div>
</div>

<style>
  :global(:root[data-theme='light']) .theme-sun,
  :global(:root[data-theme='dark']) .theme-moon { display: none; }

  .menu-link {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    min-height: 4rem; font-size: 1.625rem; font-weight: 800; letter-spacing: -0.02em; color: var(--tx);
  }
  .menu-link :global(svg) { color: var(--mut); width: 1.25rem; height: 1.25rem; }
  .menu-link[aria-current='page'] { color: var(--accent-tx); }
  .seg { display: flex; gap: 0.25rem; padding: 0.3rem; border-radius: 1rem; background: var(--surface); border: 1px solid var(--line); }
  .seg-item {
    flex: 1; display: grid; place-items: center; height: 2.75rem; border-radius: 0.75rem;
    font-size: 0.9375rem; font-weight: 700; color: var(--mut);
  }
  .seg-item[aria-current='true'] { background: var(--tx); color: var(--bg); }
  :global(:root[data-theme='dark']) .seg-dark,
  :global(:root[data-theme='light']) .seg-light { background: var(--tx); color: var(--bg); }

  .site-menu:not([hidden]) { animation: menu-in 0.22s ease-out; }
  /* On a phone the page behind the open menu stays still (a swipe on the menu used to scroll it). */
  @media (max-width: 767px) {
    :global(html.menu-open), :global(html.menu-open body) { overflow: hidden; }
    .site-menu nav { overscroll-behavior: contain; }
  }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-0.75rem); } }
</style>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]')
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]')
  if (menu && opener) {
    const closer = menu.querySelector<HTMLButtonElement>('[data-menu-close]')!
    const set = (open: boolean) => {
      menu.hidden = !open
      opener.setAttribute('aria-expanded', String(open))
      document.documentElement.classList.toggle('menu-open', open)
      if (open) closer.focus()
      else opener.focus({ preventScroll: true })
    }
    opener.addEventListener('click', () => set(true))
    closer.addEventListener('click', () => set(false))
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { menu.hidden = true; document.documentElement.classList.remove('menu-open') }))
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) set(false) })
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches && !menu.hidden) set(false) })
  }
</script>
