---
// The modules in ONE place, switched — never a long scroll (owner 2026-11-16).
// With JavaScript: a list on the left (chips on a phone) and one panel at a time, deep-linkable
// by #id. Without it: every panel shows, one under the other.
import Base from '../../layouts/Base.astro'
import Rich from '../../components/Rich.astro'
import Icon from '../../components/Icon.astro'
import Arrow from '../../components/Arrow.astro'
import CtaBand from '../../components/CtaBand.astro'
import Todo from '../../components/Todo.astro'
import { MODULES } from '../../content/modules'
import { fmtDen } from '../../data/plans'
import { LANGS, type Lang, pageHref, useT } from '../../i18n/ui'

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }))
}
const lang = Astro.params.lang as Lang
const t = useT(lang)
const PLAN_NAME = { standard: 'Стандард и Про', pro: 'Про' } as const
---
<Base lang={lang} page="moduli" title={t('page.moduli')}>
  <section class="relative overflow-hidden">
    <div class="glow -right-32 -top-24 h-[28rem] w-[28rem]" style="background:var(--glow-a)" aria-hidden="true"></div>
    <div class="wrap relative pt-14 pb-8 md:pt-20">
      <p class="kicker">{t('page.moduli')}</p>
      <h1 class="mt-4 max-w-4xl text-[2.4rem] md:text-[3.5rem]"><Rich text="Имате увоз, сервис или веб-продавница? **Има модул за тоа.**" /></h1>
      <p class="mt-6 max-w-3xl text-lg text-mut md:text-xl">Во пробниот период се вклучени сите. Потоа го задржувате само она што ви треба — дел се во плановите, дел се додаваат на кој било план.</p>
    </div>
  </section>

  <section class="wrap pb-10" data-explorer>
    <div class="grid gap-6 lg:grid-cols-[17rem_1fr]">
      <nav aria-label={t('page.moduli')} class="explorer-nav hidden min-w-0">
        <ul class="flex gap-2 overflow-x-auto pb-2 lg:flex-col lg:overflow-visible lg:pb-0" role="tablist">
          {MODULES.map((m) => (
            <li class="shrink-0">
              <a href={`#${m.id}`} role="tab" data-tab={m.id}
                 class="flex items-center gap-3 rounded-2xl border border-line bg-surface px-4 py-3 font-semibold text-mut transition hover:text-tx aria-selected:border-tx aria-selected:bg-tx aria-selected:text-bg">
                <Icon name={m.icon as any} class="h-5 w-5 shrink-0" /><span class="whitespace-nowrap">{m.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="min-w-0">
        {MODULES.map((m) => (
          <article id={m.id} data-panel={m.id} role="tabpanel" class="card mb-6 scroll-mt-28 p-7 md:p-10">
            <div class="flex flex-wrap items-center gap-3">
              <span class="grid h-12 w-12 place-items-center rounded-2xl bg-accent text-accent-ink"><Icon name={m.icon as any} /></span>
              <h2 class="text-2xl md:text-3xl">{m.name}</h2>
              <span class="ml-auto rounded-full bg-surface-2 px-3.5 py-1.5 text-sm font-bold">
                {'plan' in m.where
                  ? <>во план {PLAN_NAME[m.where.plan]}</>
                  : <>додаток · <span class="num">{fmtDen(m.where.addon)}</span> ден. / месец</>}
              </span>
            </div>
            <p class="mt-6 text-2xl font-extrabold leading-tight md:text-[2rem]"><Rich text={m.hook} /></p>
            <p class="mt-4 max-w-3xl text-lg text-mut">{m.explain}</p>
            <ul class="mt-6 grid gap-3 sm:grid-cols-2">
              {m.points.map((p) => (
                <li class="flex gap-3"><Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-accent-tx" />{p}</li>
              ))}
            </ul>
            <p class="mt-6 text-sm font-semibold text-accent-tx">✓ Вклучено во 30-те дена проба</p>
          </article>
        ))}
        <p class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href={pageHref(lang, 'ceni')} class="inline-flex items-center gap-2 font-bold underline decoration-hi decoration-4 underline-offset-4">Спореди ги плановите <Arrow /></a>
          <Todo lang={lang}>примерни цени на додатоците</Todo>
        </p>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} section="moduli" />
</Base>

<script>
  // One panel at a time; the address keeps which (#servis), so a link opens that module.
  const root = document.querySelector<HTMLElement>('[data-explorer]')
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-tab]'))
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'))
    root.querySelector('.explorer-nav')?.classList.remove('hidden')
    const show = (id: string, scroll: boolean) => {
      if (!panels.some((p) => p.dataset.panel === id)) id = panels[0]?.dataset.panel ?? ''
      panels.forEach((p) => { p.hidden = p.dataset.panel !== id })
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)))
      if (scroll) root.scrollIntoView({ behavior: 'smooth', block: 'start' })
    }
    tabs.forEach((t) => t.addEventListener('click', (e) => {
      e.preventDefault()
      const id = t.dataset.tab ?? ''
      history.replaceState(null, '', `#${id}`)
      show(id, window.innerWidth < 1024)
    }))
    show(location.hash.slice(1), false)
  }
</script>
