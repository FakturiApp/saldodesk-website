---
import Base from '../../layouts/Base.astro'
import Todo from '../../components/Todo.astro'
import { LANGS, type Lang, type Page, useT } from '../../i18n/ui'

export function getStaticPaths() {
  // Only the pages that have no file of their own: the legal texts.
  // (Inside the function: Astro runs getStaticPaths apart from the rest of the file.)
  const SHELLS: Page[] = ['uslovi', 'privatnost']
  return LANGS.flatMap((lang) => SHELLS.map((page) => ({ params: { lang, page } })))
}
const lang = Astro.params.lang as Lang
const page = Astro.params.page as Page
const t = useT(lang)
---
<Base lang={lang} page={page} title={t(`page.${page}`)}>
  <section class="wrap py-20">
    <h1 class="text-[2.4rem] md:text-[3.5rem]">{t(`page.${page}`)}</h1>
    {page === 'pomosh'
      ? <p class="mt-6 max-w-2xl text-lg text-mut">{t('wip.body')}</p>
      : <p class="mt-6"><Todo lang={lang}>текстот го пишува правник</Todo></p>}
  </section>
</Base>
