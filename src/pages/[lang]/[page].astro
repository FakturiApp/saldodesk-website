---
// The legal texts: shells until a lawyer writes them.
import Base from '../../layouts/Base.astro'
import Todo from '../../components/Todo.astro'
import { LANGS, type Lang, useT } from '../../i18n/ui'

export function getStaticPaths() {
  // (Inside the function: Astro runs getStaticPaths apart from the rest of the file.)
  const SHELLS = ['uslovi', 'privatnost'] as const
  return LANGS.flatMap((lang) => SHELLS.map((page) => ({ params: { lang, page } })))
}
const lang = Astro.params.lang as Lang
const page = Astro.params.page as 'uslovi' | 'privatnost'
const t = useT(lang)
---
<Base lang={lang} page={page} title={t(`page.${page}`)}>
  <section class="wrap py-20">
    <h1 class="text-[2.4rem] md:text-[3.5rem]">{t(`page.${page}`)}</h1>
    <p class="mt-6"><Todo lang={lang}>{t('legal.todo')}</Todo></p>
  </section>
</Base>
