---
// Контакт — a named person and a way to reach them (brief 02 §8.7). Every detail is the
// owner's to supply; nothing here is invented.
import Base from '../../layouts/Base.astro'
import Rich from '../../components/Rich.astro'
import Icon from '../../components/Icon.astro'
import Todo from '../../components/Todo.astro'
import { LANGS, type Lang, useT } from '../../i18n/ui'

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }))
}
const lang = Astro.params.lang as Lang
const t = useT(lang)
const WAYS = [
  { icon: 'pin', t: 'Телефон / Viber', v: 'телефонски број' },
  { icon: 'doc', t: 'Е-пошта', v: 'адреса за е-пошта' },
  { icon: 'history', t: 'Работно време', v: 'денови и часови на поддршката' },
]
---
<Base lang={lang} page="kontakt" title={t('page.kontakt')}>
  <section class="relative overflow-hidden">
    <div class="glow -right-32 -top-24 h-[28rem] w-[28rem]" style="background:var(--glow-a)" aria-hidden="true"></div>
    <div class="wrap relative pt-14 pb-8 md:pt-20">
      <p class="kicker">{t('page.kontakt')}</p>
      <h1 class="mt-4 max-w-4xl text-[2.4rem] md:text-[3.5rem]"><Rich text="15 минути, **вашата фирма, вашите прашања.**" /></h1>
      <p class="mt-6 max-w-3xl text-lg text-mut md:text-xl">Јавете се или пишете. Ви го покажуваме SaldoDesk на пример што личи на вашата работа и одговараме на сè — вклучително и како да преминете од вашата досегашна програма.</p>
    </div>
  </section>

  <section class="wrap grid gap-5 pb-16 lg:grid-cols-[1.2fr_1fr]">
    <div class="card p-7 md:p-10">
      <p class="text-sm font-bold uppercase tracking-wide text-mut">Лице за контакт</p>
      <p class="mt-3"><Todo lang={lang}>име, фотографија и улога</Todo></p>
      <ul class="mt-8 space-y-5">
        {WAYS.map((w) => (
          <li class="flex items-center gap-4">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-accent text-accent-ink"><Icon name={w.icon as any} /></span>
            <span><span class="block text-sm text-mut">{w.t}</span><Todo lang={lang}>{w.v}</Todo></span>
          </li>
        ))}
      </ul>
    </div>
    <div class="card p-7 md:p-10">
      <p class="text-sm font-bold uppercase tracking-wide text-mut">Фирма</p>
      <p class="mt-3"><Todo lang={lang}>назив, адреса и ЕДБ</Todo></p>
    </div>
  </section>
</Base>
