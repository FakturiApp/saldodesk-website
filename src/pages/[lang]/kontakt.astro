---
// Контакт — every detail is the owner's to supply; nothing here is invented.
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import Todo from '../../components/Todo.astro'
import PageHead from '../../components/PageHead.astro'
import { SITE } from '../../content/site'
import { LANGS, type Lang, useT } from '../../i18n/ui'

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }))
}
const lang = Astro.params.lang as Lang
const t = useT(lang)
const C = SITE[lang].contact
const WAYS = [
  { icon: 'users', t: C.person, v: C.todoPerson },
  { icon: 'pin', t: C.phone, v: C.todoPhone },
  { icon: 'doc', t: C.email, v: C.todoEmail },
  { icon: 'history', t: C.hours, v: C.todoHours },
]
---
<Base lang={lang} page="kontakt" title={C.title}>
  <PageHead title={C.title} text={C.text} />
  <section class="wrap grid gap-5 pb-20 lg:grid-cols-[1.3fr_1fr]">
    <ul class="card space-y-6 p-7 md:p-10">
      {WAYS.map((w) => (
        <li class="flex items-center gap-4">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-accent text-accent-ink"><Icon name={w.icon as any} /></span>
          <span><span class="block text-sm text-mut">{w.t}</span><Todo lang={lang}>{w.v}</Todo></span>
        </li>
      ))}
    </ul>
    <div class="card p-7 md:p-10">
      <p class="text-sm font-bold uppercase tracking-wide text-mut">SaldoDesk</p>
      <p class="mt-3"><Todo lang={lang}>{t('footer.company')}</Todo></p>
    </div>
  </section>
</Base>
