---
// Помош — the wiki: every help article of the app, grouped by topic, with a search.
// In Macedonian the search finds a word typed in Cyrillic OR Latin (as the app's search does).
import Base from '../../../layouts/Base.astro'
import Arrow from '../../../components/Arrow.astro'
import BackToTop from '../../../components/BackToTop.astro'
import { HELP_TOPICS } from '../../../content/helpMeta'
import { HELP_COPY, helpArticles } from '../../../content/helpCopy'
import { LANGS, type Lang, pageHref } from '../../../i18n/ui'

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }))
}
const lang = Astro.params.lang as Lang
const C = HELP_COPY[lang]
const all = (await helpArticles(lang)).sort((a, b) => a.data.title.localeCompare(b.data.title, lang))
const groups = HELP_TOPICS.map((g) => ({ key: g.key, name: g.name[lang], items: all.filter((a) => a.data.topic === g.key) })).filter((g) => g.items.length)
const href = (id: string) => `${pageHref(lang, 'pomosh')}${id}/`
---
<Base lang={lang} page="pomosh" title={C.title}>
  <section class="relative overflow-hidden">
    <div class="glow -right-32 -top-24 h-[28rem] w-[28rem]" style="background:var(--glow-a)" aria-hidden="true"></div>
    <div class="wrap relative pt-14 pb-8 md:pt-20">
      <h1 class="text-[2.4rem] md:text-[3.5rem]">{C.title}</h1>
      <p class="mt-4 max-w-3xl text-lg text-mut md:text-xl">{C.text(all.length)}</p>
      <label class="mt-8 flex max-w-2xl items-center gap-3 rounded-full border border-line bg-surface px-5 py-3.5 shadow-[var(--shadow)] focus-within:border-tx">
        <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-mut" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <span class="sr-only">{C.search}</span>
        <input type="search" data-help-search data-cyrillic={lang === 'mk' ? '' : undefined} placeholder={C.placeholder} class="w-full bg-transparent text-lg outline-none placeholder:text-mut" autocomplete="off" />
      </label>
      <p data-help-none hidden class="mt-4 text-mut">{C.none} <a href={pageHref(lang, 'kontakt')} class="font-bold underline decoration-hi decoration-4 underline-offset-4">{C.ask}</a>.</p>
    </div>
  </section>

  <section class="wrap pb-16">
    <nav aria-label={C.topics} class="mb-10 flex flex-wrap gap-2" data-help-topics>
      {groups.map((g) => (
        <a href={`#${g.key}`} class="rounded-full border border-line bg-surface px-4 py-2 text-sm font-semibold text-mut hover:border-tx hover:text-tx">{g.name} <span class="text-xs">{g.items.length}</span></a>
      ))}
    </nav>
    <div class="columns-1 gap-5 md:columns-2 xl:columns-3">
      {groups.map((g) => (
        <section id={g.key} class="card mb-5 break-inside-avoid scroll-mt-28 p-6" data-help-group>
          <h2 class="text-xl">{g.name}</h2>
          <ul class="mt-4 space-y-1">
            {g.items.map((a) => (
              <li data-help-item data-text={`${a.data.title} ${g.name}`}>
                <a href={href(a.id)} class="group flex items-start gap-2 rounded-xl px-2 py-1.5 text-[0.9375rem] leading-snug hover:bg-surface-2">
                  <span class="flex-1" lang={a.translated ? undefined : 'mk'}>{a.data.title}</span>
                  <span class="mt-0.5 text-mut opacity-0 transition group-hover:opacity-100"><Arrow /></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
  <BackToTop lang={lang} />
</Base>

<script>
  // Each word must match a title. In Macedonian, „storno" also finds „Сторно".
  const LAT: [RegExp, string][] = [
    [/dzh|dž/g, 'џ'], [/gj|ǵ/g, 'ѓ'], [/kj|ḱ/g, 'ќ'], [/zh|ž/g, 'ж'], [/ch|č/g, 'ч'], [/sh|š/g, 'ш'],
    [/lj/g, 'љ'], [/nj/g, 'њ'], [/dz/g, 'ѕ'], [/c/g, 'ц'], [/j/g, 'ј'], [/a/g, 'а'], [/b/g, 'б'],
    [/v|w/g, 'в'], [/g/g, 'г'], [/d/g, 'д'], [/e/g, 'е'], [/z/g, 'з'], [/i|y/g, 'и'], [/k|q/g, 'к'],
    [/l/g, 'л'], [/m/g, 'м'], [/n/g, 'н'], [/o/g, 'о'], [/p/g, 'п'], [/r/g, 'р'], [/s/g, 'с'],
    [/t/g, 'т'], [/u/g, 'у'], [/f/g, 'ф'], [/h/g, 'х'], [/x/g, 'кс'],
  ]
  const input = document.querySelector<HTMLInputElement>('[data-help-search]')
  const cyr = input?.hasAttribute('data-cyrillic') ?? false
  const toCyr = (s: string) => (cyr ? LAT.reduce((acc, [re, c]) => acc.replace(re, c), s) : s)
  const norm = (s: string) => toCyr(s.toLowerCase().replace(/[„“"'’.,!?()]/g, ' '))
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-help-item]'))
  const index = items.map((el) => norm(el.dataset.text ?? ''))
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-help-group]'))
  const none = document.querySelector<HTMLElement>('[data-help-none]')
  const topics = document.querySelector<HTMLElement>('[data-help-topics]')
  input?.addEventListener('input', () => {
    const words = norm(input.value).split(/\s+/).filter(Boolean)
    let shown = 0
    items.forEach((el, i) => {
      const ok = words.every((w) => index[i].includes(w))
      el.hidden = !ok
      if (ok) shown++
    })
    groups.forEach((g) => { g.hidden = !g.querySelector('[data-help-item]:not([hidden])') })
    if (none) none.hidden = shown > 0
    if (topics) topics.hidden = words.length > 0
  })
</script>
