---
// Цени — the three plans, the add-ons, how paying works. EXAMPLE prices (owner 2026-11-16).
import Base from '../../layouts/Base.astro'
import Arrow from '../../components/Arrow.astro'
import Icon from '../../components/Icon.astro'
import Todo from '../../components/Todo.astro'
import PageHead from '../../components/PageHead.astro'
import CtaBand from '../../components/CtaBand.astro'
import { SITE, YEAR_MONTHS } from '../../content/site'
import { CURRENCY, LANGS, type Lang, fmtNum, signupUrl, useT } from '../../i18n/ui'

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }))
}
const lang = Astro.params.lang as Lang
const t = useT(lang)
const P = SITE[lang].prices
const cur = CURRENCY[lang]
const n = (v: number) => fmtNum(lang, v)
---
<Base lang={lang} page="ceni" title={P.title}>
  <PageHead title={P.title} text={P.text}>
    <p class="mt-3"><Todo lang={lang}>{P.todo}</Todo></p>
  </PageHead>

  <section class="wrap pb-12" data-period="year" data-plans>
    <div class="inline-flex flex-wrap rounded-full border border-line bg-surface p-1.5" role="group" aria-label={`${P.month} / ${P.year}`}>
      <button type="button" data-set-period="month" class="period-btn rounded-full px-5 py-2.5 text-[0.9375rem] font-bold">{P.month}</button>
      <button type="button" data-set-period="year" class="period-btn rounded-full px-5 py-2.5 text-[0.9375rem] font-bold">
        {P.year} <span class="ml-1 rounded-full bg-hi px-2 py-0.5 text-xs text-hi-ink">{P.yearBadge}</span>
      </button>
    </div>

    <ul class="mt-12 grid gap-5 lg:grid-cols-3">
      {P.plans.map((p) => (
        <li class:list={['relative flex flex-col rounded-[2rem] p-7', p.star ? 'plan-star' : 'card']}>
          {p.star && <p class="absolute -top-3.5 left-7 rounded-full bg-accent px-3.5 py-1 text-xs font-extrabold text-accent-ink">{P.star}</p>}
          <p class="text-2xl font-extrabold">{p.name}</p>
          <p class="plan-mut mt-1 text-[0.9375rem] text-mut">{p.who}</p>
          <p class="num mt-6">
            <span class="price-month text-[2.75rem] font-extrabold leading-none">{n(p.monthly)}</span>
            <span class="price-year text-[2.75rem] font-extrabold leading-none">{n(p.monthly * YEAR_MONTHS)}</span>
            <span class="ml-1 text-sm font-semibold">{cur}</span>
            <span class="price-month plan-mut ml-1 text-sm text-mut">{P.perMonth}</span>
            <span class="price-year plan-mut ml-1 text-sm text-mut">{P.perYear}</span>
          </p>
          <p class="plan-mut mt-2 text-sm text-mut">{P.users(p.users)}</p>
          <ul class="mt-6 flex-1 space-y-2.5 text-[0.9375rem]">
            {p.lines.map((l) => (
              <li class="flex gap-2.5"><Icon name="check" class="plan-tick mt-0.5 h-5 w-5 shrink-0 text-accent-tx" />{l}</li>
            ))}
          </ul>
          <a href={signupUrl(lang)} class:list={['pill mt-8 justify-between', p.star ? 'pill-accent' : 'pill-solid']} data-event="cta_trial_click" data-section={`plan-${p.key}`}>
            <span>{t('cta.trial')}</span><span class="pill-arrow"><Arrow /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap grid gap-5 pb-16 lg:grid-cols-[1.4fr_1fr]">
    <div class="card p-7">
      <h2 class="text-xl font-extrabold">{P.addonsTitle}</h2>
      <ul class="mt-4 divide-y divide-line">
        {P.addons.map((a) => (
          <li class="flex items-baseline justify-between gap-4 py-2.5">
            <span>{a.name}</span>
            <span class="num whitespace-nowrap font-bold">{n(a.price)} {cur} <span class="text-sm font-normal text-mut">{P.perMonth}</span></span>
          </li>
        ))}
      </ul>
    </div>
    <div class="card p-7">
      <h2 class="text-xl font-extrabold">{P.factsTitle}</h2>
      <ul class="mt-4 space-y-3">
        {P.facts.map((f) => (
          <li class="flex gap-3"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent-tx" />{f}</li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} section="ceni" />
</Base>

<style>
  [data-plans][data-period='year'] .price-month,
  [data-plans][data-period='month'] .price-year { display: none; }
  .period-btn { color: var(--mut); }
  [data-plans][data-period='month'] [data-set-period='month'],
  [data-plans][data-period='year'] [data-set-period='year'] { background: var(--tx); color: var(--bg); }
  /* The recommended plan is the night card in both themes. */
  .plan-star { background: #0d1220; color: #eef1f7; box-shadow: var(--shadow); }
  .plan-star .plan-mut { color: #a6b0c3; }
  .plan-star .plan-tick { color: #3fe0ad; }
</style>

<script>
  // Monthly / yearly switch. Without JavaScript the yearly price shows.
  document.querySelectorAll<HTMLElement>('[data-plans]').forEach((box) => {
    const buttons = Array.from(box.querySelectorAll<HTMLButtonElement>('[data-set-period]'))
    const sync = () => buttons.forEach((x) => x.setAttribute('aria-pressed', String(box.dataset.period === x.dataset.setPeriod)))
    buttons.forEach((b) => b.addEventListener('click', () => { box.dataset.period = b.dataset.setPeriod; sync() }))
    sync()
  })
</script>
