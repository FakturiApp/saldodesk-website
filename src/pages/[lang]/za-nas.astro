---
// За SaldoDesk — the brand quote and what stands behind it (owner 2026-11-16: „what is our
// quote — software for self-governing business operations — read in an About field").
// The principles are each provable from the brief; who stands behind it is the owner's.
import Base from '../../layouts/Base.astro'
import Rich from '../../components/Rich.astro'
import Icon from '../../components/Icon.astro'
import CtaBand from '../../components/CtaBand.astro'
import Todo from '../../components/Todo.astro'
import { QUOTE } from '../../content/quote'
import { LANGS, type Lang, pageHref, useT } from '../../i18n/ui'

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }))
}
const lang = Astro.params.lang as Lang
const t = useT(lang)
const PRINCIPLES = [
  { icon: 'doc', t: 'Направено за македонски закон', d: 'Документите, ДДВ книгите, ДДВ-04 и е-Фактура — онака како што ги бара законот, не преведени од туѓа програма.' },
  { icon: 'lock', t: 'Податоците се ваши', d: 'Секој вработен гледа само она што смее, а вашите документи ги извезувате во секое време.' },
  { icon: 'check', t: 'Отворено за тоа што е готово', d: 'Што работи денес, а што доаѓа — пишува на страницата „Што е готово“, пред да платите.' },
  { icon: 'users', t: 'Луѓе што одговараат', d: 'Првите фирми ги водиме лично, од преминот до првата фактура.' },
]
---
<Base lang={lang} page="za-nas" title={t('page.za-nas')}>
  <section class="relative overflow-hidden">
    <div class="glow -right-32 -top-24 h-[30rem] w-[30rem]" style="background:var(--glow-a)" aria-hidden="true"></div>
    <div class="glow -left-40 bottom-0 h-[24rem] w-[24rem]" style="background:var(--glow-b)" aria-hidden="true"></div>
    <div class="wrap relative pt-16 pb-14 md:pt-24">
      <p class="kicker">{t('page.za-nas')}</p>
      <blockquote class="mt-6 max-w-5xl">
        <p class="text-[2.6rem] font-extrabold leading-[1.05] tracking-tight md:text-[4.25rem]"><Rich text={QUOTE.text} /></p>
      </blockquote>
      <p class="mt-8 max-w-3xl text-lg text-mut md:text-xl">{QUOTE.lead}</p>
    </div>
  </section>

  <section class="wrap py-12">
    <h2 class="text-3xl md:text-[2.5rem]"><Rich text="Што значи тоа **во пракса**" /></h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {PRINCIPLES.map((p) => (
        <li class="card p-7">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-accent text-accent-ink"><Icon name={p.icon as any} /></span>
          <p class="mt-5 text-xl font-bold">{p.t}</p>
          <p class="mt-2 text-mut">{p.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap py-12">
    <div class="card grid gap-6 p-7 md:grid-cols-[1fr_1.2fr] md:p-10">
      <h2 class="text-2xl md:text-3xl">Кој стои зад SaldoDesk</h2>
      <div class="space-y-3 text-mut">
        <p><Todo lang={lang}>фирмата, луѓето и приказната зад SaldoDesk</Todo></p>
        <p><a href={pageHref(lang, 'kontakt')} class="font-bold text-tx underline decoration-hi decoration-4 underline-offset-4">Јавете ни се</a> · <a href={pageHref(lang, 'status')} class="font-bold text-tx underline decoration-hi decoration-4 underline-offset-4">Што е готово</a></p>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} section="za-nas" />
</Base>
