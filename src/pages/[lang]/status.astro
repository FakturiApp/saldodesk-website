---
// Што е готово — the honest list (brief 02 §8.4, brief 01 §9). Keep it current at every
// release: a claim here that the app does not keep is the one thing this page must never do.
import Base from '../../layouts/Base.astro'
import Rich from '../../components/Rich.astro'
import CtaBand from '../../components/CtaBand.astro'
import { LANGS, type Lang, useT } from '../../i18n/ui'

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }))
}
const lang = Astro.params.lang as Lang
const t = useT(lang)
const COLS = [
  {
    key: 'ready', title: 'Готово', dot: 'bg-accent',
    items: [
      'Сите документи: фактури, понуди, испратници, книжни, внатрешни',
      'Залиха и набавна цена, со поправка кога цената доцни',
      'Плаќања, долгови, аванси и компензации',
      'ДДВ книги и ДДВ-04',
      'Извештаи: промет, добивка, споредби',
      'Пренос од друга програма: партнери, производи, почетна состојба',
      'Модули: магацини, увоз/извоз, набавки, финансии, отпад, сервис, изнајмување, веб-продавница',
      'Помош во програмата, на македонски',
    ],
  },
  {
    key: 'doing', title: 'Во изработка', dot: 'bg-[#4d87cd]',
    items: [
      'Потпишување на е-Фактура од прелистувач и првата фактура во тест-системот на УЈП',
      'Регистрација со е-пошта и пробен период за цела фирма',
      'Помош на албански и англиски',
    ],
  },
  {
    key: 'later', title: 'Планирано', dot: 'bg-mut',
    items: [
      'Прием на е-фактури од добавувачи',
      'Фискален печатач од прелистувач',
      'Вчитување банкарски извод',
      'Пренос на старите документи од друга програма',
      'Изглед прилагоден за телефон',
    ],
  },
]
---
<Base lang={lang} page="status" title={t('page.status')}>
  <section class="relative overflow-hidden">
    <div class="glow -right-32 -top-24 h-[28rem] w-[28rem]" style="background:var(--glow-a)" aria-hidden="true"></div>
    <div class="wrap relative pt-14 pb-8 md:pt-20">
      <p class="kicker">{t('page.status')}</p>
      <h1 class="mt-4 max-w-4xl text-[2.4rem] md:text-[3.5rem]"><Rich text="Што е готово, а што доаѓа. **Отворено.**" /></h1>
      <p class="mt-6 max-w-3xl text-lg text-mut md:text-xl">SaldoDesk е нов. Подобро да знаете однапред што работи денес, отколку да дознаете по купувањето.</p>
      <p class="mt-3 text-sm text-mut">Состојба: ноември 2026</p>
    </div>
  </section>

  <section class="wrap grid gap-5 pb-12 lg:grid-cols-3">
    {COLS.map((c) => (
      <div class="card p-7">
        <p class="flex items-center gap-3 text-xl font-extrabold"><span class:list={['h-3 w-3 rounded-full', c.dot]}></span>{c.title}</p>
        <ul class="mt-5 space-y-3 text-[0.9375rem]">
          {c.items.map((i) => <li class="border-t border-line pt-3">{i}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <CtaBand lang={lang} section="status" />
</Base>
